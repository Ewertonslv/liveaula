{
  "name": "@liveaula/api",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma migrate deploy && node dist/scripts/bootstrap.js && node dist/server.js",
    "start:server-only": "node dist/server.js",
    "test": "jest --forceExit",
    "lint": "eslint src --ext .ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@liveaula/shared": "file:../../packages/shared",
    "@prisma/client": "^5.13.0",
    "@sentry/node": "^10.51.0",
    "axios": "^1.15.2",
    "bcryptjs": "^2.4.3",
    "expo-server-sdk": "^3.7.0",
    "fastify": "^4.27.0",
    "fastify-plugin": "^4.5.1",
    "jose": "^5.3.0",
    "resend": "^6.12.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.13.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.9.0",
    "typescript": "^5.4.0"
  }
